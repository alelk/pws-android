# Shared by every flow: selector ids, timeouts, test data. One KEY="value" per line.
# Ids mirror production code (testTag / contentDescription). E2eSelectorParityTest keeps them in sync.
# APP_ID / APK_PATH are resolved by run-e2e.sh from --flavor; do not set them here unless overriding.

# Navigation (contentDescription = route name)
NAV_HOME="home"
NAV_SEARCH="search"
NAV_LIBRARY="library"

# Actions / fields (testTag = "<kind>:<name>")
ACTION_OPEN_SETTINGS="action:open-settings"
ACTION_TOGGLE_FAVORITE="action:toggle-favorite"
ACTION_SKIP_ONBOARDING="action:skip-onboarding"
FIELD_SEARCH="field:search"

# Rows: stable prefix + id
SONG_ITEM_ONE="song-row-1"

# Loading indicators that some flows anchor on on purpose
ONBOARDING_LOADING="onboarding-loading"

# System UI we do not own (keyboard). Gboard's space bar; used only as a "keyboard is up" probe.
IME_SPACE_KEY="com.google.android.inputmethod.latin:id/key_pos_space"

# Locale-independent test data (ASCII, guaranteed to exist in every flavor's seed)
SEARCH_QUERY_NUMERIC="1"
TEST_TAG_NAME="E2E_SMOKE_TAG"

# Timeouts, ms. Cold start after clearState creates the DB: give it its own, generous constant.
TIMEOUT_SHORT=5000
TIMEOUT_MEDIUM=10000
TIMEOUT_LONG=15000
TIMEOUT_COLD_START=30000
TIMEOUT_BOOK_INSTALL=120000
